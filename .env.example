# Telegram MTProto Credentials
# Get your API ID & Hash from https://my.telegram.org/apps
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here

# Telegram StringSession generated via GramJS
TELEGRAM_SESSION=your_gramjs_string_session_here

# Optional LiteLLM / OpenAI API Key (can also be entered directly in the UI)
# OPENAI_API_KEY=your_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
