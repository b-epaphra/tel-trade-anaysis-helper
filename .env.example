# ===================================================
# Telegram Signal Verifier - Environment Configuration
# ===================================================

# 1. Telegram MTProto Credentials
# Obtain your API ID & API Hash from https://my.telegram.org/apps
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here

# 2. Telegram StringSession
# Generated via GramJS / TelegramClient. Required to maintain a persistent, non-interactive login.
TELEGRAM_SESSION=your_gramjs_string_session_here

# 3. Database Connection (PostgreSQL / Vercel Postgres / Neon)
# On Vercel, this is automatically injected when you attach Vercel Postgres in the Storage tab.
DATABASE_URL="postgresql://username:password@ep-host.pooler.region.postgres.vercel-storage.com/verceldb?sslmode=require"

# 4. Backend Access Control & Security (Optional but Recommended)
# Protects your API routes and ensures unauthorized visitors cannot trigger heavy syncs or API calls.
# If left empty, API routes will be publicly accessible.
ADMIN_PASSWORD=your_admin_secret_password_here

# 5. Optional AI Report Integration (Can also be entered in the UI directly)
# OPENAI_API_KEY=your_openai_or_litellm_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
